{
  "name": "anki-xml",
  "version": "0.0.1",
  "description": "AI-agent-friendly CLI for importing, querying, and updating Anki flashcards via AnkiConnect. Built for autonomous loops: deterministic, idempotent, recoverable, composable.",
  "keywords": [
    "anki",
    "anki-connect",
    "flashcards",
    "spaced-repetition",
    "xml",
    "cli",
    "ai-agent",
    "llm-tool",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/master8848/Anki-import#readme",
  "bugs": "https://github.com/master8848/Anki-import/issues",
  "author": "master8848",
  "license": "MIT",
  "main": "src/index.ts",
  "bin": {
    "anki-xml": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "skills",
    "!skills/_artifacts"
  ],
  "directories": {
    "bin": "./dist",
    "doc": "./docs"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "import": "bun run src/index.ts import",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:npm && bun run publish:check",
    "publish:check": "bun run scripts/publish-check.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "fast-xml-parser": "^5.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/iarna__toml": "^2.0.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master8848/Anki-import.git",
    "directory": "."
  }
}
