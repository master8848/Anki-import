{
  "name": "anki-xml",
  "version": "0.0.3",
  "description": "XML-first CLI for importing Anki flashcards via AnkiConnect. Streaming, validated, recoverable.",
  "keywords": [
    "anki",
    "anki-connect",
    "flashcards",
    "xml",
    "cli",
    "ai-agent"
  ],
  "homepage": "https://github.com/master8848/Anki-import#readme",
  "bugs": "https://github.com/master8848/Anki-import/issues",
  "author": "master8848",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "anki-import": "./dist/cli.js",
    "anki-xml": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "tsx src/index.ts",
    "import": "tsx src/index.ts import",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/master8848/Anki-import.git"
  }
}
