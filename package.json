{
  "name": "anki-xml",
  "version": "0.0.6",
  "description": "Git + Terraform for Anki knowledge. XML-first infrastructure-as-code toolkit for Anki collections.",
  "keywords": [
    "anki",
    "anki-connect",
    "flashcards",
    "xml",
    "cli",
    "ai-agent",
    "infrastructure-as-code"
  ],
  "homepage": "https://github.com/master8848/Anki-import#readme",
  "bugs": "https://github.com/master8848/Anki-import/issues",
  "author": "master8848",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "anki-import": "./dist/cli.js",
    "anki-xml": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "rslib build && chmod +x dist/cli.js",
    "start": "tsx packages/cli/src/index.ts",
    "import": "tsx packages/cli/src/index.ts import",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doctor": "node dist/cli.js doctor",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "release:version": "node scripts/version-sync.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "5.6.0",
    "fast-xml-parser": "5.11.1",
    "valibot": "1.4.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@rslib/core": "0.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@anki-xml/anki": "workspace:*",
    "@anki-xml/checkpoint": "workspace:*",
    "@anki-xml/cli": "workspace:*",
    "@anki-xml/config": "workspace:*",
    "@anki-xml/core": "workspace:*",
    "@anki-xml/diff": "workspace:*",
    "@anki-xml/logger": "workspace:*",
    "@anki-xml/mcp": "workspace:*",
    "@anki-xml/media": "workspace:*",
    "@anki-xml/models": "workspace:*",
    "@anki-xml/parser": "workspace:*",
    "@anki-xml/planner": "workspace:*",
    "@anki-xml/rollback": "workspace:*",
    "@anki-xml/stats": "workspace:*",
    "@anki-xml/sync": "workspace:*",
    "@anki-xml/tags": "workspace:*",
    "@anki-xml/utils": "workspace:*",
    "@anki-xml/validation": "workspace:*"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "trustedDependencies": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/master8848/Anki-import.git"
  }
}
