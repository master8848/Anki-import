{
  "name": "anki-xml",
  "version": "0.1.0",
  "description": "AI-agent-friendly CLI for importing, querying, and updating Anki flashcards via AnkiConnect. Built for autonomous loops: deterministic, idempotent, recoverable, composable.",
  "keywords": [
    "anki",
    "anki-connect",
    "flashcards",
    "spaced-repetition",
    "xml",
    "cli",
    "ai-agent",
    "llm-tool"
  ],
  "homepage": "https://github.com/YOUR-USERNAME/anki-xml#readme",
  "bugs": "https://github.com/YOUR-USERNAME/anki-xml/issues",
  "license": "MIT",
  "bin": {
    "anki-xml": "./src/index.ts"
  },
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "import": "bun run src/index.ts import",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "publish:check": "bun run scripts/publish-check.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-USERNAME/anki-xml.git",
    "directory": "."
  }
}
